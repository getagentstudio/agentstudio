---
import HomePage from "../../src/home-page/HomePage.astro";
import { getHomeChapters } from "../../src/chapters/chapter-catalog";
import type { ProofClip, ProofClipManifest } from "../../src/chapters/proof-clips";
import posterUrl from "./proof-poster.jpg?url";
import videoUrl from "./proof-video.mp4?url";

function fixtureClip(stepId: string): ProofClip {
  return {
    desktopVideo: `${videoUrl}?step=${stepId}&size=desktop`,
    phoneVideo: `${videoUrl}?step=${stepId}&size=phone`,
    poster: posterUrl,
    accessibleLabel: `Fixture ${stepId}`,
  };
}
const clips = {
  "proof-run": fixtureClip("proof-run"),
  "proof-review": fixtureClip("proof-review"),
  "proof-panes": fixtureClip("proof-panes"),
} satisfies ProofClipManifest;
---
<HomePage chapters={getHomeChapters(clips)} />
