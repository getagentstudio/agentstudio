---
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import GitHubMark from "@/github-action/GitHubMark.astro";
import { marketingCopy } from "@/marketing-copy";
import { siteMetadata } from "@/site-metadata";
import XMark from "@/social-links/XMark.astro";
import "@/styles/global.css";

import FullPageTopologyBackdrop from "./FullPageTopologyBackdrop.astro";
import { siteStructuredData } from "./site-structured-data";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly canonicalPath?: string | undefined;
  readonly socialUrlPath?: string | undefined;
}

const { title, description, canonicalPath, socialUrlPath } = Astro.props;
const canonicalUrl = new URL(
  canonicalPath ?? Astro.url.pathname,
  siteMetadata.canonicalOrigin,
).href;
const socialUrl = new URL(socialUrlPath ?? canonicalUrl, siteMetadata.canonicalOrigin).href;
const socialImageUrl = new URL(siteMetadata.socialCard.path, siteMetadata.canonicalOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191B1F" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={appLogo.src} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marketingCopy.productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={socialUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(siteMetadata.socialCard.width)} />
    <meta property="og:image:height" content={String(siteMetadata.socialCard.height)} />
    <meta property="og:image:alt" content={siteMetadata.socialCard.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={siteMetadata.socialCard.alt} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteStructuredData).replace(/</gu, "\\u003c")} />
  </head>
  <body>
    <a
      href="#top"
      data-skip-to-content
      class="fixed top-3 left-4 z-50 -translate-y-[200%] rounded-control border border-primary bg-product-ground px-4 py-3 text-ink focus:translate-y-0 focus:outline-2 focus:outline-primary"
    >{marketingCopy.navigation.skipToContent}</a>
    <FullPageTopologyBackdrop />
    <div class="site-header-anchor sticky top-0 z-20 h-18" data-site-header-anchor>
      <header
        class="site-header floating-glass-material relative top-px z-20 mx-auto flex min-h-18 items-center justify-between rounded-floating-shell border border-[rgb(137_180_250/24%)] px-5.5 py-4"
        data-site-header
        data-visual-state="resting"
      >
        <a
          class="brand-link inline-flex items-center gap-3 font-bold"
          href="#top"
          aria-label={marketingCopy.navigation.homeLabel}
        >
          <img src={appLogo.src} width="32" height="32" alt="" />
          <span>{marketingCopy.productName}</span>
        </a>
        <nav
          class="flex items-center gap-2 text-[14px] text-ink-muted max-phone:gap-1"
          aria-label={marketingCopy.navigation.primaryLabel}
        >
          <a
            class="header-social-action grid size-8 place-items-center hover:text-ink"
            href={marketingCopy.githubUrl}
            aria-label={marketingCopy.navigation.githubAction}
          >
            <GitHubMark />
          </a>
          <a
            class="header-social-action grid size-8 place-items-center hover:text-ink [&_.social-mark]:size-4"
            href={marketingCopy.socialLinks.x.url}
            aria-label={marketingCopy.socialLinks.x.label}
          >
            <XMark />
          </a>
        </nav>
      </header>
      <div class="site-header-frost" aria-hidden="true"></div>
    </div>
    <div
      class="site-frame relative z-[1] mx-auto mb-4 w-[min(calc(100%-32px),var(--container-frame))] overflow-visible bg-transparent max-lg:m-0 max-lg:w-full"
    >
      <main id="top" tabindex="-1" class="scroll-mt-24">
        <slot />
      </main>
    </div>
    <script>
      const floatingHeaderScrollThreshold = 32;
      const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");

      if (siteHeader !== null) {
        let pendingAnimationFrame: number | undefined;

        const synchronizeHeaderVisualState = (): void => {
          const nextVisualState =
            window.scrollY > floatingHeaderScrollThreshold ? "floating" : "resting";
          if (siteHeader.dataset["visualState"] !== nextVisualState) {
            siteHeader.dataset["visualState"] = nextVisualState;
          }
        };

        const scheduleHeaderVisualStateUpdate = (): void => {
          if (pendingAnimationFrame !== undefined) {
            return;
          }

          pendingAnimationFrame = window.requestAnimationFrame((): void => {
            pendingAnimationFrame = undefined;
            synchronizeHeaderVisualState();
          });
        };

        synchronizeHeaderVisualState();
        window.addEventListener("scroll", scheduleHeaderVisualStateUpdate, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  .site-header {
    width: calc(
      min(calc(100% - 32px), var(--container-frame)) - var(--spacing-page-inline) -
        var(--spacing-page-inline)
    );
    background:
      linear-gradient(135deg, rgb(137 180 250 / 7%), transparent 42%, rgb(116 199 236 / 4%)),
      rgb(30 30 46 / 78%);
    box-shadow:
      0 8px 30px rgb(10 11 17 / 16%),
      inset 0 1px rgb(255 255 255 / 7%);
    backdrop-filter: blur(20px) saturate(120%);
    -webkit-backdrop-filter: blur(20px) saturate(120%);
    transition:
      top 280ms cubic-bezier(0.22, 1, 0.36, 1),
      width 360ms cubic-bezier(0.22, 1, 0.36, 1),
      min-height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 360ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms ease,
      background-color 280ms ease,
      box-shadow 360ms ease;
  }

  .site-header[data-visual-state="floating"] {
    @apply top-3 min-h-16 rounded-floating-shell px-5.5 py-3;
    width: min(80vw, 672px);
  }

  .site-header-frost {
    @apply h-9;
    position: fixed;
    z-index: 19;
    top: 0;
    left: 50%;
    width: min(80vw, 672px);
    pointer-events: none;
    opacity: 0;
    background: transparent;
    transform: translateX(-50%);
    backdrop-filter: blur(4px) saturate(120%);
    -webkit-backdrop-filter: blur(4px) saturate(120%);
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8px,
      #000 calc(100% - 8px),
      transparent 100%
    );
    transition: opacity 240ms ease;
  }

  .site-header[data-visual-state="floating"] + .site-header-frost {
    opacity: 1;
  }

  @media (width < 64rem) {
    .site-header {
      width: calc(100% - var(--spacing-page-inline) - var(--spacing-page-inline));
    }

    .site-header[data-visual-state="resting"] {
      @apply top-0 w-full rounded-none border-0;
    }
  }

  @media (width < 38.75rem) {
    .site-header[data-visual-state="floating"] {
      @apply px-4.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
