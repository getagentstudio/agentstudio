---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"video">, "class" | "poster" | "src"> {
  readonly accessibilityLabel: string;
  readonly autoplayOnScroll?: boolean;
  readonly deferSource?: boolean;
  readonly class?: string;
  readonly fallbackText?: string;
  readonly poster?: ImageMetadata | string;
  readonly replayDelayMs?: number;
  readonly source: string;
  readonly sourceType?: string;
  readonly startProgress?: number;
  readonly stopProgress?: number;
}

const {
  accessibilityLabel,
  autoplayOnScroll = true,
  deferSource = false,
  class: className,
  fallbackText = "This browser cannot play this video.",
  poster,
  replayDelayMs = 3000,
  source,
  sourceType = "video/mp4",
  startProgress = 0.95,
  stopProgress = 0.9,
  ...videoAttributes
} = Astro.props;

const posterUrl = typeof poster === "string" ? poster : poster?.src;
---

<video
  {...videoAttributes}
  controls
  muted
  playsinline
  preload={deferSource ? "none" : "metadata"}
  poster={posterUrl}
  aria-label={accessibilityLabel}
  class={className}
  data-scroll-autoplay-video={autoplayOnScroll ? "" : undefined}
  data-scroll-autoplay-start-progress={autoplayOnScroll ? startProgress : undefined}
  data-scroll-autoplay-stop-progress={autoplayOnScroll ? stopProgress : undefined}
  data-scroll-autoplay-replay-delay-ms={autoplayOnScroll ? replayDelayMs : undefined}
>
  <source src={deferSource ? undefined : source} data-src={deferSource ? source : undefined} type={sourceType} />
  <span>{fallbackText}</span>
</video>
