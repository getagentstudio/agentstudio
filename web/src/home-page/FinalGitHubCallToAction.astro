---
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import {
  railAnchorAttribute,
  railSurfaceTargetAttribute,
  railTargetEdgeAttribute,
  railTerminalTargetAttribute,
} from "@/chapters/chapter-dom-contract";
import { installCommandText, marketingCopy } from "@/marketing-copy";

const terminalRailAttributes = {
  [railAnchorAttribute]: "final-cta",
  [railSurfaceTargetAttribute]: "final-cta",
  [railTargetEdgeAttribute]: "left",
  [railTerminalTargetAttribute]: "",
};
---

<section class="final-cta relative grid grid-cols-1 justify-items-start px-page-inline text-left" aria-labelledby="final-cta-title" data-finale-root data-finale-state="settled">
  <div class="finale-heading inline-flex items-center" data-finale-heading>
    <div class="finale-stage relative" aria-hidden="true">
      <div class="finale-fan">
        <div class="finale-plane finale-plane--rear-one" data-finale-rear-one></div>
        <div class="finale-plane finale-plane--rear-two" data-finale-rear-two></div>
        <div class="finale-plane finale-plane--front" data-finale-front>
          <svg viewBox="0 0 610 390" aria-hidden="true"><path d="M205 135 L275 187 L205 239" fill="none" stroke="#74c7ec" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"></path><path d="M325 241 L425 241" fill="none" stroke="#74c7ec" stroke-width="24" stroke-linecap="round"></path></svg>
        </div>
        <div class="finale-terminal" data-finale-terminal>
          <div class="finale-terminal__bar"><span>● ● ●</span></div>
          <span class="finale-terminal__prompt">&gt;_</span>
        </div>
      </div>
      <img class="finale-app-logo" data-finale-logo src={appLogo.src} width="108" height="108" alt="" decoding="async" />
    </div>
    <h2 id="final-cta-title" class="m-0 font-display text-closing-display font-extrabold">{marketingCopy.productName}</h2>
  </div>

  <div class="finale-pill-frame relative inline-flex max-w-full">
  <div
    class="finale-split-pill floating-glass-material relative inline-flex max-w-full items-stretch overflow-hidden rounded-full border text-step-label font-normal text-ink"
    {...terminalRailAttributes}
    data-finale-split-pill
    data-install-command-root
    data-install-command={installCommandText}
    data-install-copied-label={marketingCopy.installation.copiedStatus}
    data-install-feedback-ms="2000"
  >
    <a class="final-star-button relative z-[1] inline-flex items-center justify-center" data-final-star-button href={marketingCopy.githubUrl} target="_blank" rel="noopener noreferrer">
      <svg class="finale-action-icon finale-github-icon" viewBox="0 0 24 24" aria-hidden="true"><path data-finale-github-outline d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.8c0-1.1-.4-1.8-1-2.2 3.3-.4 6.8-1.6 6.8-7.2 0-1.6-.6-2.9-1.6-4 .2-.4.7-1.9-.2-4.1 0 0-1.3-.4-4.3 1.6a15 15 0 0 0-7.8 0C4 0 2.7.4 2.7.4c-.9 2.2-.4 3.7-.2 4.1C1.5 5.6 1 6.9 1 8.5c0 5.6 3.5 6.8 6.8 7.2-.5.4-1 1.1-1 2.2V22" transform="translate(1 1) scale(.9)"></path></svg>
      <span class="finale-label-full">{marketingCopy.finalCallToAction.starOnGitHub}</span>
      <span class="finale-label-short">{marketingCopy.finalCallToAction.starShort}</span>
    </a>
    <button type="button" class="finale-copy-button relative z-[1] inline-flex items-center justify-center" data-install-copy aria-label={marketingCopy.installation.copyButton}>
      <svg class="finale-action-icon" viewBox="0 0 24 24" aria-hidden="true"><g data-install-copy-icon><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path></g><path data-install-copied-icon d="m5 12 4 4L19 6" data-install-icon-hidden></path></svg>
      <span class="finale-label-full" data-install-copy-feedback>{marketingCopy.finalCallToAction.copyInstall}</span>
      <span class="finale-label-short" data-install-copy-feedback>{marketingCopy.finalCallToAction.copyShort}</span>
    </button>
    <span class="sr-only" data-install-status aria-live="polite"></span>
    <code data-install-code hidden>{installCommandText}</code>
  </div>
  <svg class="finale-border-trace pointer-events-none absolute inset-0 z-[2] h-full w-full overflow-visible" aria-hidden="true"><path data-finale-border-trace></path></svg>
  </div>

  <p class="m-0 text-[14px] text-ink-faint">{marketingCopy.installation.systemRequirement}</p>
</section>

<script>
  import { initializeFinaleBookend } from "@/finale-bookend/finale-bookend-playback";

  const root = document.querySelector<HTMLElement>("[data-finale-root]");
  const pill = root?.querySelector<HTMLElement>("[data-finale-split-pill]");
  if (root !== null && root !== undefined && pill !== null && pill !== undefined) {
    initializeFinaleBookend(root);
  }
</script>

<style>
  .final-cta { --finale-left-inset: var(--spacing-rail-gutter); isolation: isolate; gap: 13px; margin-top: clamp(240px, 24vw, 400px); padding-top: 26px; padding-bottom: 26px; }
  .finale-heading { margin-left: var(--finale-left-inset); gap: 0.25em; font-size: var(--text-closing-display); white-space: nowrap; }
  .finale-stage { flex: none; width: 1.127em; height: 1em; font-size: 0.92em; pointer-events: none; }
  .finale-fan { position: absolute; inset: 0; transform: translateX(0.081em) scale(0.68, 0.67); transform-origin: left center; }
  .finale-plane, .finale-terminal { position: absolute; left: 0.132em; top: 0.09em; width: 1.389em; height: 0.875em; border-radius: 0.118em; box-shadow: 0 0.063em 0.153em #0005; transform-origin: 50% 55%; }
  .finale-plane--rear-one { z-index: 1; border: 1px solid #ef9f76; background: #191b1f; transform: translate(-0.167em, -0.007em) rotate(-12deg); }
  .finale-plane--rear-two { z-index: 2; border: 1px solid #ef9f76; background: #191b1f; transform: translate(-0.076em, -0.028em) rotate(7deg); }
  .finale-plane--front { z-index: 3; display: grid; place-items: center; border: 1px solid #89b4fa; background: #1e1e2e; transform: rotate(0deg); }
  .finale-plane--front svg { display: block; width: 100%; height: 100%; }
  .finale-terminal { z-index: 4; overflow: hidden; border: 1px solid rgb(137 180 250 / 38%); background: #282c34; box-shadow: 0 0.111em 0.236em #0004; }
  .finale-terminal__bar { height: 0.153em; border-bottom: 1px solid rgb(255 255 255 / 10%); background: #30343c; text-align: left; }
  .finale-terminal__bar span { margin-left: 1.1em; color: #ef9f76; font-size: 0.069em; letter-spacing: 0.2em; }
  .finale-terminal__prompt { position: absolute; left: 9%; top: 35.7%; color: #74c7ec; font: 0.16em var(--font-mono-product); }
  .finale-app-logo { position: absolute; z-index: 5; top: -0.131em; left: -0.123em; width: 1.35em; height: 1.35em; max-width: none; object-fit: contain; }
  .final-cta[data-finale-state="ready"] .finale-app-logo, .final-cta[data-finale-state="playing"] .finale-app-logo { opacity: 0; }
  .final-cta[data-finale-state="ready"] .finale-github-icon, .final-cta[data-finale-state="ready"] .finale-border-trace { opacity: 0; }
  .final-cta[data-finale-state="settled"] .finale-plane, .final-cta[data-finale-state="settled"] .finale-terminal { opacity: 0; }
  .final-cta[data-finale-state="settled"] .finale-border-trace { opacity: 0; }
  .finale-pill-frame { width: max-content; justify-self: start; margin-top: 19px; margin-left: var(--finale-left-inset); }
  .finale-split-pill { width: max-content; min-height: 50px; white-space: nowrap; }
  .final-cta:is([data-finale-state="ready"], [data-finale-state="playing"]) .finale-split-pill { border-color: transparent; box-shadow: inset 0 0 0 1px var(--color-floating-glass-border), var(--floating-glass-shadow); }
  .final-cta > p { margin-top: 22px; margin-left: var(--finale-left-inset); }
  .final-star-button, .finale-copy-button { min-height: 48px; gap: 9px; padding: 0 22px; font: inherit; color: inherit; white-space: nowrap; }
  .final-star-button { min-width: 200px; border-radius: 999px 0 0 999px; }
  .finale-copy-button { min-width: 180px; cursor: pointer; border-radius: 0 999px 999px 0; }
  .finale-copy-button::before { position: absolute; top: 25%; bottom: 25%; left: 0; width: 1px; background: color-mix(in srgb, var(--color-floating-glass-border) 55%, transparent); content: ""; }
  .final-star-button:hover, .finale-copy-button:hover { background: rgb(255 255 255 / 7%); }
  .final-star-button:focus-visible, .finale-copy-button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -4px; }
  .finale-action-icon { width: 15px; height: 15px; flex: none; opacity: 0.7; }
  .finale-action-icon path, .finale-action-icon rect { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .finale-action-icon [data-install-icon-hidden] { display: none; }
  .finale-label-short { display: none; }
  .finale-border-trace path { fill: none; stroke: var(--color-floating-glass-border); stroke-width: 1px; }
  .final-cta[data-short-labels] .finale-label-full { display: none; }
  .final-cta[data-short-labels] .finale-label-short { display: inline; }
  .final-cta[data-short-labels] .final-star-button, .final-cta[data-short-labels] .finale-copy-button { min-width: 0; }
  @media (width < 38.75rem) {
    .final-cta { gap: 9px; padding-top: 17px; padding-bottom: 20px; }
    .finale-pill-frame { margin-top: 16px; }
    .finale-split-pill { min-height: 47px; }
    .final-cta > p { margin-top: 25px; }
    .final-star-button, .finale-copy-button { min-width: 0; min-height: 45px; padding: 0 16px; }
    .finale-label-full { display: none; }
    .finale-label-short { display: inline; }
  }
  @media (width < 360px) {
    .finale-heading, .finale-heading h2 { font-size: clamp(28px, 10vw, 36px); }
  }
</style>
