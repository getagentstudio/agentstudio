---
import { Image } from "astro:assets";

import parallelAgentsImage from "@/assets/captures/parallel-agents.png";
import parallelWorkPhoneImage from "@/assets/captures/parallel-work-phone.png";
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import {
  railAnchorAttribute,
  railMediaTargetAttribute,
  railSurfaceTargetAttribute,
  railTargetEdgeAttribute,
} from "@/chapters/chapter-dom-contract";
import { marketingCopy } from "@/marketing-copy";
import {
  heroIntroCopyAttribute,
  heroIntroDescriptionAttribute,
  heroIntroEyebrowSettledAttribute,
  heroIntroGlowAttribute,
  heroIntroHeadlineFirstAttribute,
  heroIntroHeadlineSecondAttribute,
  heroIntroInstallAttribute,
  heroIntroPayoffFirstAttribute,
  heroIntroPayoffSecondAttribute,
  heroIntroRootAttribute,
  heroIntroStateAttribute,
} from "@/hero-intro/hero-intro-dom-contract";
import HeroTerminalWindow from "@/hero-intro/HeroTerminalWindow.astro";

import { heroLoopMedia } from "./hero-loop-media";
import { createPhoneCaptureSources } from "./capture-image-sources";
import HeroLoopVideo from "./HeroLoopVideo.astro";
import InstallCommand from "./InstallCommand.astro";
import ScrollMaterialSurface from "./ScrollMaterialSurface.astro";

// The rail treats the hero like a chapter: its dot aligns with the eyebrow and
// its branch joins the app frame (left edge on wide/laptop, top edge on phone).
const heroRailId = "hero";
const railAnchorAttributes = { [railAnchorAttribute]: heroRailId };
const appFrameRailAttributes = {
  [railSurfaceTargetAttribute]: heroRailId,
  [railTargetEdgeAttribute]: "top",
  [railMediaTargetAttribute]: heroRailId,
};
// Lines may break between the eyebrow's sentences, never inside "Repo-aware."
// or "Terminal-first.".
const eyebrowPhrases = marketingCopy.hero.eyebrow.split(/(?<=\.)\s+/u);
const [payoffFirst, payoffSecond] = marketingCopy.hero.headlinePayoff.split(/(?<=\.)\s+/u);
const phoneCaptureSources = await createPhoneCaptureSources(parallelWorkPhoneImage);
---

<!--
  The owner prefers air to peek: the hero keeps fluid gaps between the
  payoff and the description and between the install row and the app frame,
  and trims the headline size rather than those gaps when the frame sinks.
  The description follows the first image. The bottom
  padding tops up the first chapter's own block so the hero-to-chapter gap is
  one section block.
-->
<section
  class="hero relative pt-[clamp(32px,1.5vw+3vh,80px)] pr-page-inline pb-[calc(var(--spacing-section-block)-var(--spacing-chapter-block))] pl-[calc(var(--spacing-page-inline)+var(--spacing-rail-gutter))]"
  aria-labelledby="hero-title"
  {...{ [heroIntroRootAttribute]: "", [heroIntroStateAttribute]: "settled" }}
>
  <div class="hero-glow" {...{ [heroIntroGlowAttribute]: "" }} aria-hidden="true"></div>
  <div class="hero-first-screen">
  <div class="relative z-[2] max-w-hero lg:pl-[clamp(24px,2.6vw,56px)]">
    <p
      {...railAnchorAttributes}
      class="eyebrow relative m-0 font-mono-product text-eyebrow tracking-eyebrow text-ink-faint uppercase"
    >
      <span {...{ [heroIntroEyebrowSettledAttribute]: "" }}>
        {
          eyebrowPhrases.map((phrase, phraseIndex) => (
            <>
              {phraseIndex > 0 && " "}
              <span class="whitespace-nowrap">{phrase}</span>
            </>
          ))
        }
      </span>
    </p>
    <h1
      id="hero-title"
      class="mt-4 mb-0 max-w-hero font-display text-[clamp(34px,4.6vw,80px)] leading-[0.9] font-extrabold tracking-[-0.05em]"
      aria-label={marketingCopy.hero.headline}
      {...{ [heroIntroCopyAttribute]: "" }}
    >
      <span class="block whitespace-nowrap max-phone:text-balance max-phone:whitespace-normal" {...{ [heroIntroHeadlineFirstAttribute]: "" }}
        >{marketingCopy.hero.headlineSetupFirst}</span
      >
      <span class="block whitespace-nowrap max-phone:text-balance max-phone:whitespace-normal" {...{ [heroIntroHeadlineSecondAttribute]: "" }}>
        {marketingCopy.hero.headlineSetupSecondBeforeAccent}<span
          >{marketingCopy.hero.headlineSetupSecondAccent}</span
        >
      </span>
      <span
        class="mt-[0.25em] block text-[clamp(24px,3.2vw,54px)] leading-[0.96] tracking-[-0.035em] whitespace-nowrap text-primary max-phone:text-[20px]"
        ><span {...{ [heroIntroPayoffFirstAttribute]: "" }}>{payoffFirst}</span><span {...{ [heroIntroPayoffSecondAttribute]: "" }}> {payoffSecond}</span></span
      >
    </h1>
  </div>

  <div class="hero-intro-column relative z-[2] mt-hero-copy">
    <HeroTerminalWindow />
    <div class="hero-install-row mt-5 flex justify-center" {...{ [heroIntroInstallAttribute]: "" }}>
      <div class="hero__actions flex w-full flex-wrap items-center justify-center gap-3 max-phone:flex-col max-phone:flex-nowrap max-phone:items-stretch lg:w-auto lg:flex-none">
        <InstallCommand />
      </div>
    </div>
  </div>
  <button type="button" class="hero-scroll-cue" data-hero-scroll-cue aria-label={marketingCopy.hero.scrollCueAriaLabel}>
    <span aria-hidden="true">⌄</span><span>{marketingCopy.hero.scrollCue}</span>
  </button>
  </div>

  <div class="hero-frame-flow scroll-material-lift-group" data-scroll-material-lift-target>
  <ScrollMaterialSurface
    {...appFrameRailAttributes}
    staticMaterial
    class="hero-app-frame relative mt-hero-frame border p-[clamp(6px,0.7vw,12px)]"
    data-hero-app-frame
  >
    <div
      class="aspect-[16/10] overflow-clip rounded-control bg-product-ground max-phone:aspect-auto"
    >
      {
        heroLoopMedia === undefined ? (
          <picture class="block h-full w-full">
            <source
              media="(width < 38.75rem)"
              srcset={phoneCaptureSources}
              sizes="calc(100vw - 72px)"
              width={parallelWorkPhoneImage.width}
              height={parallelWorkPhoneImage.height}
            />
            <Image
              src={parallelAgentsImage}
              alt={marketingCopy.stories.parallelWork.imageDescription}
              widths={[720, 1080, 1440, 2560]}
              sizes="(width < 38.75rem) 100vw, (width <= 90rem) 90vw, 1296px"
              format="png"
              quality={100}
              loading="lazy"
              decoding="async"
              class="block h-full w-full object-cover object-top"
            />
          </picture>
        ) : (
          <HeroLoopVideo media={heroLoopMedia} />
        )
      }
    </div>
  </ScrollMaterialSurface>
  <div class="chapter-caption mt-3" data-hero-caption>
    <div class="chapter-caption__content">
      <span class="chapter-caption__icon" data-hero-caption-icon><img src={appLogo.src} width="20" height="20" alt="" aria-hidden="true" /></span>
      <p class="chapter-caption__copy m-0" {...{ [heroIntroDescriptionAttribute]: "" }}>
        {marketingCopy.hero.description}
      </p>
    </div>
  </div>
  </div>
</section>

<style>
  .hero { isolation: isolate; overflow-x: clip; }
  .hero-first-screen { position: relative; }
  @media (width >= 64rem) {
    .hero-first-screen { padding-bottom: 28px; }
    .hero-first-screen .hero-scroll-cue { bottom: 0; }
  }
  @media (width < 64rem) {
    .hero { padding-top: 0; }
    .hero-first-screen {
      position: relative;
      display: flex;
      height: 100svh;
      min-height: 0;
      margin-top: -4.5rem;
      flex-direction: column;
      justify-content: space-evenly;
      gap: 54px;
      padding-top: calc(4.5rem + clamp(32px, 1.5vw + 3vh, 80px));
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
    .hero-first-screen .hero-intro-column { display: flex; flex: 1 1 auto; min-height: 0; flex-direction: column; margin-top: 0; }
    .hero-first-screen :global(.hero-intro-root) { display: flex; flex: 1 1 auto; flex-direction: column; }
    .hero-first-screen :global(.hero-terminal-window) { flex: 1 1 auto; }
  }
  @media (width < 38.75rem) and (height < 44rem) {
    .hero-first-screen {
      gap: 52px;
      padding-top: calc(4.5rem + 8px);
      padding-bottom: calc(42px + env(safe-area-inset-bottom));
    }
  }
  @media (width < 38.75rem) and (height >= 44rem) and (height < 54rem) {
    .hero-first-screen { gap: 52px; padding-bottom: calc(61px + env(safe-area-inset-bottom)); }
  }
  @media (width >= 38.75rem) and (width < 64rem) {
    .hero-first-screen { gap: 102px; }
  }
  .hero-scroll-cue {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: calc(16px + env(safe-area-inset-bottom));
    left: 0;
    display: flex;
    width: max-content;
    align-items: center;
    gap: 6px;
    margin: auto;
    border: 0;
    background: transparent;
    color: var(--color-ink-faint);
    cursor: pointer;
    font: 12px var(--font-mono-product);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }
  .hero[data-hero-intro-state="settled"][data-hero-frame-below-fold]:not([data-hero-scrolled]) .hero-scroll-cue {
    opacity: 1;
    pointer-events: auto;
    animation: hero-scroll-bob 650ms ease-in-out 1;
  }
  @media (width < 64rem) {
    .hero[data-hero-intro-state="settled"]:not([data-hero-scrolled]) .hero-scroll-cue {
      opacity: 1;
      pointer-events: auto;
      animation: hero-scroll-bob 650ms ease-in-out 1;
    }
  }
  @keyframes hero-scroll-bob { 50% { translate: 0 5px; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue { transition: none; }
    .hero[data-hero-intro-state="settled"][data-hero-frame-below-fold]:not([data-hero-scrolled]) .hero-scroll-cue,
    .hero[data-hero-intro-state="settled"]:not([data-hero-scrolled]) .hero-scroll-cue { animation: none; }
  }
  @media (width >= 64rem) and (height <= 56.25rem) {
    .hero { padding-top: clamp(24px, 1.5vw + 3vh - 12px, 72px); }
    #hero-title { font-size: clamp(34px, 3.2vw, 54px); }
    #hero-title > span:last-child { font-size: clamp(24px, 2.6vw, 43px); }
    .hero-intro-column { margin-top: 88px; }
  }
  .hero-intro-column { width: 100%; }
  .hero-glow { position: absolute; z-index: 0; top: -12%; bottom: 0; left: 0; right: 0; pointer-events: none; background: radial-gradient(ellipse 64% 65% at 54% 38%, #282c34 0%, rgb(40 44 52 / 75%) 34%, transparent 73%); }
  /* The rail marks the hero frame while the hero is current; its hairline lights blue. */
  :global(.hero-app-frame.scroll-material-surface[data-rail-current]) {
    border-color: rgb(137 180 250 / 88%);
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero-intro-root]");
  const cue = hero?.querySelector<HTMLButtonElement>("[data-hero-scroll-cue]");
  const firstImage = hero?.querySelector<HTMLElement>("[data-hero-app-frame]");
  if (hero !== null && hero !== undefined && cue !== null && cue !== undefined && firstImage !== null && firstImage !== undefined) {
    const markScrolled = (): void => {
      hero.toggleAttribute("data-hero-scrolled", window.scrollY >= 40);
    };
    const frameVisibility = new IntersectionObserver(([entry]): void => {
      if (entry !== undefined) {
        hero.toggleAttribute("data-hero-frame-below-fold", entry.boundingClientRect.top >= window.innerHeight);
      }
    });
    frameVisibility.observe(firstImage);
    window.addEventListener("scroll", markScrolled, { passive: true });
    markScrolled();
    cue.addEventListener("click", (): void => firstImage.scrollIntoView({ behavior: "smooth", block: "start" }));
  }
</script>
