---
import { sceneRootAttribute } from "@/chapters/chapter-dom-contract";
import AgentTerminal from "@/recreation-kit/AgentTerminal.astro";
import AppWindow from "@/recreation-kit/AppWindow.astro";
import CommandBar from "@/recreation-kit/CommandBar.astro";
import Pane from "@/recreation-kit/Pane.astro";
import PaneGrid from "@/recreation-kit/PaneGrid.astro";

import {
  findAndFocusAccessibleLabel,
  findAndFocusCommandBar,
  findAndFocusLeftFooter,
  findAndFocusLeftTerminal,
  findAndFocusParts,
  findAndFocusRightFooter,
  findAndFocusRightTerminal,
  findAndFocusTargetFooter,
  findAndFocusTargetTerminal,
  findAndFocusToolbar,
} from "./chapter-find-and-focus-fixture";

const sceneRootAttributes = { [sceneRootAttribute]: "chapter-find-and-focus" };
---

<!-- Settled frame of "Find it, focus it"; the scene module animates toward it. -->
<AppWindow
  {...sceneRootAttributes}
  class="scene-find-and-focus"
  role="img"
  aria-label={findAndFocusAccessibleLabel}
  toolbar={findAndFocusToolbar}
  arrangementSuffixPart={findAndFocusParts.arrangementZoom}
>
  <PaneGrid class="scene-find-and-focus__grid">
    <Pane footer={findAndFocusLeftFooter} phoneRole="hidden" class="scene-find-and-focus__yielding">
      <AgentTerminal lines={findAndFocusLeftTerminal} />
    </Pane>
    <Pane
      footer={findAndFocusTargetFooter}
      phoneRole="shown"
      focused
      scenePart={findAndFocusParts.targetPane}
      focusRingPart={findAndFocusParts.targetFocusRing}
      zoomedChipPart={findAndFocusParts.targetZoomedChip}
    >
      <AgentTerminal lines={findAndFocusTargetTerminal} scenePart={findAndFocusParts.targetTerminal} />
    </Pane>
    <Pane footer={findAndFocusRightFooter} phoneRole="hidden" class="scene-find-and-focus__yielding">
      <AgentTerminal lines={findAndFocusRightTerminal} />
    </Pane>
  </PaneGrid>
  <CommandBar
    commandBar={findAndFocusCommandBar}
    settledPresence="collapsed"
    scenePart={findAndFocusParts.commandBar}
    placeholderPart={findAndFocusParts.commandPlaceholder}
    queryPart={findAndFocusParts.commandQuery}
    shortcutPart={findAndFocusParts.commandShortcut}
  />
</AppWindow>

<style is:global>
  /*
   * --scene-zoom is Pane Zoom's progress, tweened on the scene root. The
   * declared value is the settled frame: the found pane owns the workspace.
   */
  .scene-find-and-focus {
    --scene-zoom: 1;
  }

  .scene-find-and-focus .kit-window__body {
    position: relative;
  }

  .scene-find-and-focus .kit-terminal [data-line-kind="shell-prompt"] {
    font-size: 0.7em;
  }

  @container recreation-kit (max-width: 600px) {
    .scene-find-and-focus .kit-terminal [data-line-kind="shell-prompt"] {
      font-size: 1em;
    }
  }

  .scene-find-and-focus .scene-find-and-focus__yielding {
    flex-grow: calc(1 - var(--scene-zoom));
    /* Each yielding pane gives back half of the pane gap on either side. */
    margin-inline: calc(var(--scene-zoom) * -0.175em);
    opacity: calc(1 - var(--scene-zoom));
  }
</style>
