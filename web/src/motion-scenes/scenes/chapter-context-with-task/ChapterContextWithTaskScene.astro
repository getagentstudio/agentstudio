---
import { sceneRootAttribute, sceneStepTargetAttribute } from "@/chapters/chapter-dom-contract";
import AgentTerminal from "@/recreation-kit/AgentTerminal.astro";
import AppWindow from "@/recreation-kit/AppWindow.astro";
import Drawer from "@/recreation-kit/Drawer.astro";
import FileTree from "@/recreation-kit/FileTree.astro";
import Pane from "@/recreation-kit/Pane.astro";
import PaneGrid from "@/recreation-kit/PaneGrid.astro";
import SourceView from "@/recreation-kit/SourceView.astro";
import { scenePartAttributes } from "@/recreation-kit/recreation-kit-dom";

import {
  contextWithTaskAccessibleLabel,
  contextWithTaskAgentFooter,
  contextWithTaskAgentTerminal,
  contextWithTaskDrawerTerminal,
  contextWithTaskFileTree,
  contextWithTaskParts,
  contextWithTaskSource,
  contextWithTaskToolbar,
} from "./chapter-context-with-task-fixture";

const sceneRootAttributes = { [sceneRootAttribute]: "chapter-context-with-task" };
const filesStepAttributes = { [sceneStepTargetAttribute]: "files" };
---

<!-- Settled frame of "Context stays with the task"; the scene module animates toward it. -->
<AppWindow
  {...sceneRootAttributes}
  class="scene-context-with-task"
  role="img"
  aria-label={contextWithTaskAccessibleLabel}
  toolbar={contextWithTaskToolbar}
>
  <PaneGrid class="scene-context-with-task__grid">
    <Pane
      footer={contextWithTaskAgentFooter}
      phoneRole="shown"
      footerBadgesPart={contextWithTaskParts.footerBadges}
    >
      <AgentTerminal
        lines={contextWithTaskAgentTerminal}
        scenePart={contextWithTaskParts.agentTerminal}
      />
      <Drawer slot="drawer" scenePart={contextWithTaskParts.drawer}>
        <AgentTerminal
          lines={contextWithTaskDrawerTerminal}
          scenePart={contextWithTaskParts.drawerTerminal}
        />
      </Drawer>
    </Pane>
    <div
      class="scene-context-with-task__files"
      {...filesStepAttributes}
      {...scenePartAttributes(contextWithTaskParts.filesPanel)}
    >
      <SourceView
        source={contextWithTaskSource}
        scenePart={contextWithTaskParts.sourceView}
        linePartPrefix={contextWithTaskParts.sourceLinePrefix}
      />
      <FileTree
        rows={contextWithTaskFileTree}
        currentView="files"
        phoneRole="hidden"
        scenePart={contextWithTaskParts.fileTree}
      />
    </div>
  </PaneGrid>
</AppWindow>

<style is:global>
  /*
   * Scene-level progress values. The module tweens them on the scene root; the
   * rules below map one value to the desktop layout and the phone crop. The
   * Files defaults to its settled frame; drawer overflow is measured at build time.
   */
  .scene-context-with-task {
    --scene-drawer-scroll: 0;
    --scene-files-reveal: 1;
  }

  .scene-context-with-task .scene-context-with-task__grid {
    position: relative;
  }

  .scene-context-with-task [data-scene-part="drawer-terminal"] > [data-line] {
    translate: 0 calc(var(--scene-drawer-scroll) * -1px);
  }

  /* Desktop: Files grows in beside the task, cancelling the pane gap while closed. */
  .scene-context-with-task .scene-context-with-task__files {
    display: flex;
    flex-grow: calc(var(--scene-files-reveal) * 1.45);
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: calc((var(--scene-files-reveal) - 1) * 0.35em);
    overflow: hidden;
  }

  @container recreation-kit (max-width: 600px) {
    .scene-context-with-task .kit-pane__drawer-slot {
      --scene-drawer-scroll: 88;
    }

    /* Phone: the task pane and its drawer fill the crop; Files slides over it. */
    .scene-context-with-task .scene-context-with-task__files {
      position: absolute;
      inset: 0.1em 0.35em 0.35em;
      margin-left: 0;
      translate: calc((1 - var(--scene-files-reveal)) * 104%) 0;
    }

    .scene-context-with-task .kit-pane__drawer-slot {
      flex-basis: 52%;
    }

    /* Lines scrolled up must not show through the drawer's top padding. */
    .scene-context-with-task [data-scene-part="drawer-terminal"] {
      padding-block: 0.4em;
      clip-path: inset(0.4em 0 0 0);
    }
  }
</style>
