---
import { sceneRootAttribute } from "@/chapters/chapter-dom-contract";
import AppWindow from "@/recreation-kit/AppWindow.astro";
import DiffView from "@/recreation-kit/DiffView.astro";
import FileTree from "@/recreation-kit/FileTree.astro";
import KitIcon from "@/recreation-kit/KitIcon.astro";
import Pane from "@/recreation-kit/Pane.astro";
import { scenePartAttributes } from "@/recreation-kit/recreation-kit-dom";

import {
  reviewAccessibleLabel,
  reviewDiff,
  reviewFiles,
  reviewFooter,
  reviewParts,
  reviewToolbar,
} from "./chapter-review-fixture";

const sceneRootAttributes = { [sceneRootAttribute]: "chapter-review" };
---

<AppWindow
  {...sceneRootAttributes}
  class="scene-review"
  role="img"
  aria-label={reviewAccessibleLabel}
  toolbar={reviewToolbar}
>
  <Pane footer={reviewFooter} phoneRole="shown">
    <div class="scene-review__main" {...scenePartAttributes(reviewParts.diffView)}>
      <DiffView diff={reviewDiff} annotationAfterLine={{ kind: "added", lineNumber: 49 }}>
        <section
          slot="annotation"
          class="scene-review__thread"
          aria-label="AGENTS.md:49 annotation thread"
          {...scenePartAttributes(reviewParts.commentThread)}
        >
          <div class="scene-review__summary">
            <span class="scene-review__count">1 comment</span>
            <span aria-hidden="true">·</span>
            <span>Open</span>
            <span class="scene-review__actions">
              <span class="scene-review__action"><KitIcon name="return" />Reply</span>
              <span class="scene-review__action"><KitIcon name="check" />Resolve</span>
            </span>
          </div>
          <div class="scene-review__message">
            <span class="scene-review__avatar" aria-label="Your avatar">Y</span>
            <div class="scene-review__message-content">
              <div class="scene-review__metadata"><strong>You</strong><span aria-hidden="true">·</span><span>2m</span></div>
              <p>Keep the comparison dated. The <code>current.md</code> pin can stay brief.</p>
            </div>
          </div>
        </section>
      </DiffView>
    </div>
  </Pane>
  <FileTree rows={reviewFiles} currentView="review" phoneRole="hidden" />
</AppWindow>

<style is:global>
  .scene-review__main {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .scene-review .kit-pane__content { display: flex; }
  .scene-review .kit-diff-view__line[data-diff-kind="added"] .kit-diff-view__number {
    color: rgb(165 171 181);
  }
  .scene-review [data-scene-part="review-changed-line"] {
    box-shadow: inset 0 0 0 1px rgb(137 180 250 / 80%);
  }
  .scene-review__thread {
    margin: 0.6em 1em;
    padding: 0.8em 1em;
    border: 1px solid var(--kit-annotation-border);
    border-radius: 0.9em;
    background: var(--kit-canvas);
    color: var(--kit-text);
    font-family: var(--kit-font-ui);
  }
  .scene-review__summary, .scene-review__metadata {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--kit-text-faint);
    font-size: max(11px, 0.9em);
    line-height: 1.333;
  }
  .scene-review__count, .scene-review__metadata strong { color: var(--kit-text); font-weight: 500; }
  .scene-review__actions { display: flex; gap: 0.75em; margin-left: auto; }
  .scene-review__action { display: inline-flex; align-items: center; gap: 0.25em; }
  .scene-review__action :global(.kit-icon) { width: 1em; height: 1em; }
  .scene-review__message { display: flex; align-items: flex-start; gap: 0.6em; margin-top: 0.5em; }
  .scene-review__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: var(--kit-card);
    color: var(--kit-text);
    font-size: max(11px, 0.9em);
    font-weight: 600;
  }
  .scene-review__message-content { min-width: 0; }
  .scene-review__thread p { margin: 0.2em 0 0; font-size: max(12px, 1em); line-height: 1.333; }
  .scene-review__thread code { font-family: var(--kit-font-mono); }
</style>
