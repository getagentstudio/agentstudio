---
import { codexFinaleTranscript, codexTranscript } from "./hero-terminal-transcripts";
import { heroIntroFinaleRowAttribute, heroTranscriptTierAttribute } from "./hero-intro-dom-contract";

const preludeRows = codexTranscript.slice(0, 6);
const currentRows = codexTranscript.slice(6);
---

<section class="hero-terminal-pane hero-terminal-pane--codex" aria-hidden="true">
  <div class="hero-pane-lift" data-hero-pane-lift="codex"></div>
  <div class="hero-terminal-transcript">
    <div class="hero-codex-startup">
      <div><span class="hero-terminal-muted">&gt;_ </span><strong>OpenAI Codex</strong><span class="hero-terminal-muted"> (v0.156.1)</span></div>
      <div class="hero-codex-startup-blank"></div>
      <div><span class="hero-terminal-muted">model:　　</span>GPT-6.1-Sol high　<span class="hero-terminal-blue">/model</span><span class="hero-terminal-muted"> to change</span></div>
      <div><span class="hero-terminal-muted">directory: </span>~/agent-studio</div>
    </div>
    {
      preludeRows.map((row) => {
        const resultIndex = row.kind === "codex-detail" ? row.text.indexOf("14 passed") : -1;
        return (
          <div
            class={`hero-transcript-row hero-transcript-row--${row.kind}`}
            {...{ [heroTranscriptTierAttribute]: row.tiers.join(" ") }}
          >
            {row.kind === "codex-action" ? (
              <><span class="hero-terminal-dim">•</span>{" "}<span class="hero-terminal-lavender">{row.text.slice(2)}</span></>
            ) : resultIndex >= 0 ? (
              <><span class="hero-terminal-muted">{row.text.slice(0, resultIndex)}</span><span class="hero-terminal-muted">14 passed</span><span class="hero-terminal-muted">{row.text.slice(resultIndex + "14 passed".length)}</span></>
            ) : row.kind === "codex-prose" ? (
              <><span class="hero-terminal-dim">•</span><span class="hero-terminal-muted">{row.text.slice(1)}</span></>
            ) : row.text}
          </div>
        );
      })
    }
    <div class="hero-codex-swap-slot">
      <div class="hero-codex-current-rows">
        {
          currentRows.map((row) => {
            const resultIndex = row.kind === "codex-detail" ? row.text.indexOf("14 passed") : -1;
            return (
              <div class={`hero-transcript-row hero-transcript-row--${row.kind}`} {...{ [heroTranscriptTierAttribute]: row.tiers.join(" ") }}>
                {row.kind === "codex-action" ? (
                  <><span class="hero-terminal-dim">•</span>{" "}<span class="hero-terminal-lavender">{row.text.slice(2)}</span></>
                ) : resultIndex >= 0 ? (
                  <><span class="hero-terminal-muted">{row.text.slice(0, resultIndex)}</span><span class="hero-terminal-muted">14 passed</span><span class="hero-terminal-muted">{row.text.slice(resultIndex + "14 passed".length)}</span></>
                ) : row.kind === "codex-prose" ? (
                  <><span class="hero-terminal-dim">•</span><span class="hero-terminal-muted">{row.text.slice(1)}</span></>
                ) : row.text}
              </div>
            );
          })
        }
      </div>
      <div class="hero-codex-finale-rows">
        {
          codexFinaleTranscript.map((row) => (
            <div class={`hero-transcript-row hero-transcript-row--${row.kind}`} {...{ [heroTranscriptTierAttribute]: row.tiers.join(" "), [heroIntroFinaleRowAttribute]: "" }} {...(row.beat === "working" ? { "data-hero-codex-working": "" } : {})} {...(row.beat === "running" ? { "data-hero-codex-running": "" } : {})} {...(row.beat === "command" ? { "data-hero-worktree-command": "" } : {})} {...(row.beat === "worktree" ? { "data-hero-worktree-row": "" } : {})} {...(row.beat === "result" ? { "data-hero-worktree-result": "" } : {})}>
              {row.beat === "working" ? (
                <><span class="hero-terminal-dim">•</span>{" "}<span class="hero-working-shimmer">Working</span><span class="hero-terminal-dim" data-hero-codex-working-meta> (1s • esc to interrupt)</span></>
              ) : row.kind === "codex-action" ? (
                <><span class="hero-terminal-dim">•</span>{" "}<span class="hero-terminal-lavender" {...(row.beat === "running" ? { "data-hero-codex-verb": "" } : {})}>{row.text.slice(2)}</span></>
              ) : row.text}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="hero-codex-footer">
    <div class="hero-codex-input"><span>›</span><span class="hero-codex-input-slot"><span data-hero-codex-placeholder>Ask Codex to do anything</span><span data-hero-codex-typed-input></span></span></div>
    <div class="hero-codex-status"><span class="hero-terminal-amber">GPT-6.1-Sol high</span> · <span class="hero-terminal-peach">Context 94% left</span> · <span class="hero-terminal-lavender">main</span></div>
  </div>
</section>
