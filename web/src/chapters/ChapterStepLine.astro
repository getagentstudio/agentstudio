---
import type { ChapterStep } from "./chapter-catalog";
import { railStepLineTargetAttribute } from "./chapter-dom-contract";

interface Props {
  readonly chapterId: string;
  readonly steps: readonly ChapterStep[];
}

const { chapterId, steps } = Astro.props;
---

<div class="chapter-step-line floating-glass-material relative h-[78px] w-[min(100%,480px)]" data-chapter-step-line>
  <!-- The rail joins the bare line before its first commit dot. -->
  <span class="chapter-step-line__start absolute top-[11.5px] left-0 h-px w-px" {...{ [railStepLineTargetAttribute]: chapterId }} aria-hidden="true"></span>
  <span class="chapter-step-progress-track" aria-hidden="true"></span>
  <span class="chapter-step-progress-fill" aria-hidden="true"></span>
  <svg class="chapter-step-ring" data-chapter-step-ring data-ring-hidden viewBox="0 0 26 26" aria-hidden="true">
    <circle class="chapter-step-ring__track" cx="13" cy="13" r="11" />
    <circle class="chapter-step-ring__progress" data-chapter-step-ring-progress cx="13" cy="13" r="11" />
    <circle class="chapter-step-ring__core" cx="13" cy="13" r="6.5" />
  </svg>
  <span class="chapter-step-pause-glyph" data-chapter-step-pause-glyph aria-hidden="true" hidden>❚❚</span>
  <div class="chapter-step-list absolute top-0 left-4 flex items-center" data-chapter-step-list>
    {
      steps.map((step, stepIndex) => (
        <button
          type="button"
          class="chapter-step relative z-[3] flex h-6 w-6 flex-none cursor-pointer items-center justify-center rounded-full disabled:cursor-default"
          data-chapter-step={step.id}
          data-step-state={stepIndex === 0 ? "current" : "upcoming"}
          aria-label={step.label}
          disabled
          tabindex="-1"
        >
          <span class="chapter-step__dot" aria-hidden="true" />
          <span class="sr-only" data-chapter-step-label>{step.label}</span>
        </button>
      ))
    }
  </div>
  <svg class="chapter-step-branch pointer-events-none absolute inset-0 h-[64px] w-full overflow-visible" aria-hidden="true">
    <path class="chapter-step-active-branch" d="M 28 12 C 28 47.1 29.9 51 47 51 L 52 51" data-chapter-step-branch />
  </svg>
  <span class="chapter-step-active-label floating-glass-material absolute top-[37px] left-[52px] rounded-full border px-3 py-1 text-step-label font-normal whitespace-nowrap text-ink" data-chapter-step-active-label aria-hidden="true"><span data-chapter-step-active-label-text>{steps[0]?.label}</span></span>
</div>

<style>
  .chapter-step-line { border: 0; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: none; }
  .chapter-step-progress-track,
  .chapter-step-progress-fill {
    position: absolute;
    top: 11.25px;
    left: 0;
    height: var(--rail-line-width);
    pointer-events: none;
  }
  .chapter-step-ring { position: absolute; z-index: 2; top: -1px; left: 28px; width: 26px; height: 26px; overflow: visible; translate: -50% 0; pointer-events: none; }
  .chapter-step-ring[data-ring-hidden], .chapter-step-pause-glyph[hidden] { display: none; }
  .chapter-step-ring circle { fill: none; stroke-width: 2; }
  .chapter-step-ring__track { stroke: rgb(255 255 255 / 8%); }
  .chapter-step-ring__progress { stroke: var(--color-primary); stroke-linecap: round; transform: rotate(-90deg); transform-origin: center; stroke-dasharray: 69.115; }
  .chapter-step-ring__core { fill: #282c34; stroke: var(--color-primary); stroke-width: 2; filter: drop-shadow(0 0 3px rgb(137 180 250 / 35%)); }
  .chapter-step-line:has(.chapter-step-ring:not([data-ring-hidden])) .chapter-step[data-step-state="current"] .chapter-step__dot { opacity: 0; }
  .chapter-step-pause-glyph { position: absolute; top: -17px; left: var(--chapter-step-current-center, 28px); translate: -50% 0; color: rgb(155 161 173 / 80%); font-size: 9px; line-height: 10px; pointer-events: none; }
  .chapter-step-line[data-step-playback="paused"] .chapter-step-ring { opacity: 0.5; }
  .chapter-step-progress-track {
    width: var(--chapter-step-track-width, 0px);
    background: color-mix(in srgb, var(--color-primary) 46%, transparent);
  }
  .chapter-step-progress-fill {
    width: var(--chapter-step-progress-width, 0px);
    background: var(--color-primary);
    transition: width 300ms ease-out;
  }
  .chapter-step:nth-child(n + 2) { margin-left: 44px; }
  .chapter-step__dot {
    width: 9px;
    height: 9px;
    border: 1.5px solid rgb(155 161 173 / 80%);
    border-radius: 999px;
    background: #282c34;
  }
  .chapter-step[data-step-state="passed"] .chapter-step__dot {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }
  .chapter-step[data-step-state="current"] .chapter-step__dot {
    width: 13px;
    height: 13px;
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 2px rgb(137 180 250 / 42%), 0 0 6px rgb(137 180 250 / 35%);
  }
  .chapter-step-active-branch {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 46%, transparent);
    stroke-width: var(--rail-line-width);
    stroke-linecap: round;
  }
  .chapter-step-active-label { max-width: calc(100% - var(--chapter-step-label-left, 52px)); overflow: hidden; text-overflow: ellipsis; }
  @media (width < 38.75rem) {
    .chapter-step:nth-child(n + 2) { margin-left: -2px; }
    .chapter-step-ring { width: 24px; height: 24px; top: 0; }
    .chapter-step-ring__track, .chapter-step-ring__progress { r: 10; }
  }
  @media (width < 64rem) {
    .chapter-step-pause-glyph { top: -7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter-step-progress-fill { transition: none; }
  }
</style>
