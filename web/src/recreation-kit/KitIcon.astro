---
import type { KitIconName } from "./kit-icon-names";

interface Props {
  readonly name: KitIconName;
  readonly class?: string;
}

const { name, class: className } = Astro.props;

// Each glyph is a list of SVG path strings on a 16-unit grid, stroked with
// currentColor so kit components color icons through text color alone.
const glyphPaths: Readonly<Record<KitIconName, readonly string[]>> = {
  search: ["M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Z", "m11 11 3.5 3.5"],
  sort: ["M5 2.5v11m0 0-2.5-2.5M5 13.5 7.5 11", "M11 13.5v-11m0 0L8.5 5M11 2.5 13.5 5"],
  repository: ["M3.5 2.5h8a1 1 0 0 1 1 1v8h-9a1 1 0 0 0-1 1V3.5a1 1 0 0 1 1-1Z", "M5.5 12.5v2l1-.7 1 .7v-2"],
  columns: ["M2.5 3.5h11v9h-11z", "M6.5 3.5v9"],
  trash: ["M3 4.5h10", "M6 4.5V3h4v1.5", "M4.5 4.5l.7 9h5.6l.7-9"],
  pane: ["M2.5 3h11v10h-11z", "M6.5 3v10"],
  terminal: ["M2.5 3h11v10h-11z", "m5 7 1.8 1.5L5 10", "M8.5 10.5h2.5"],
  branch: ["M5 3v7", "M5 12.5a1.5 1.5 0 1 0 0 .01", "M11 5.5a1.5 1.5 0 1 0 0-.01", "M11 7c0 2.5-3 2.5-6 4"],
  worktree: ["M4 4a1.5 1.5 0 1 0 0-.01", "M12 4a1.5 1.5 0 1 0 0-.01", "M8 13a1.5 1.5 0 1 0 0-.01", "M4 5.5C4 9 8 8 8 11.5M12 5.5C12 9 8 8 8 11.5"],
  stack: ["M3.5 6h9v7.5h-9z", "M4.5 4h7", "M5.5 2.5h5"],
  bell: ["M4 11.5V7a4 4 0 0 1 8 0v4.5l1 1H3z", "M6.5 13.5a1.5 1.5 0 0 0 3 0"],
  "folder-plus": ["M2 4.5V12.5h12V5.5H8L6.5 4H2z", "M8 7.5v3.5M6.25 9.25h3.5"],
  "layout-grid": ["M2.5 2.5h11v11h-11z", "M8 2.5v11M2.5 8h11"],
  arrangement: ["M2.5 3.5h5v9h-5z", "M9.5 3.5h4v9h-4z"],
  "chevron-left": ["m10 3-5 5 5 5"],
  "chevron-right": ["m6 3 5 5-5 5"],
  "chevron-down": ["m3 6 5 5 5-5"],
  plus: ["M8 2.5v11M2.5 8h11"],
  drawer: ["M2.5 3h11v10h-11z", "M2.5 9.5h11"],
  pencil: ["m3 13 1-3.5 7-7 2.5 2.5-7 7z"],
  "pull-request": ["M4.5 3v10", "M4.5 3a1.5 1.5 0 1 0 0 .01", "M11.5 13a1.5 1.5 0 1 0 0 .01", "M11.5 11.5V6.5c0-1-.5-1.5-1.5-1.5H7.5m0 0 1.5-1.5M7.5 5 9 6.5"],
  code: ["M5.5 4.5 2 8l3.5 3.5", "M10.5 4.5 14 8l-3.5 3.5", "m9 3-2 10"],
  copy: ["M5.5 5.5h7v8h-7z", "M3.5 10.5v-8h7"],
  zoom: ["M2.5 5.5v-3h3M10.5 2.5h3v3M13.5 10.5v3h-3M5.5 13.5h-3v-3", "M5.5 5.5h5v5h-5z"],
  folder: ["M2 4.5V12.5h12V5.5H8L6.5 4H2z"],
  file: ["M4 2h5l3 3v9H4z", "M9 2v3h3"],
  "file-typescript": ["M3 3h10v10H3z", "M5 7h3M6.5 7v4", "M11 7.3c-.4-.4-1.9-.5-1.9.4 0 1 2 .6 2 1.8 0 1-1.6 1-2.1.5"],
  "file-markdown": ["M2 4.5h12v7H2z", "M4 10V6.5l1.5 1.8L7 6.5V10", "M11 6.5V10m0 0-1.3-1.3M11 10l1.3-1.3"],
  gear: ["M8 10.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4Z", "M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"],
  files: ["M4 2h5l3 3v9H4z", "M6 8h4M6 10.5h4"],
  review: ["M2.5 4h2M2.5 8h2M2.5 12h2", "M6.5 4h7M6.5 8h7M6.5 12h7"],
  sliders: ["M2.5 4.5h11M2.5 8h11M2.5 11.5h11", "M5 3v3M10.5 6.5v3M7 10v3"],
  "close-circle": ["M8 14.5a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Z", "m5.8 5.8 4.4 4.4M10.2 5.8l-4.4 4.4"],
  clock: ["M8 14a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z", "M8 4.5V8l2.2 1.5"],
  return: ["M13 3.5v4.5H4", "M6.5 5.5 4 8l2.5 2.5"],
  "arrow-right": ["M2.5 8h11", "M9.5 4l4 4-4 4"],
  check: ["m3 8 3.2 3.2L13 4.5"],
};

const paths = glyphPaths[name];
---

<svg
  class:list={["kit-icon", className]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((path) => <path d={path} />)}
</svg>

<style>
  .kit-icon {
    display: inline-block;
    flex: none;
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.16em;
  }
</style>
