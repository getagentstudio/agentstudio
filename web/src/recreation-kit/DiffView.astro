---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitDiffViewModel } from "./recreation-kit-model";

interface Props {
  readonly diff: KitDiffViewModel;
  readonly scenePart?: string | undefined;
  readonly annotationAfterLine?: {
    readonly kind: "context" | "added" | "removed";
    readonly lineNumber: number;
  } | undefined;
}

const { diff, scenePart, annotationAfterLine } = Astro.props;
---

<!-- One file of the continuous Review diff, as in review.png. -->
<div class="kit-diff-view" {...scenePartAttributes(scenePart)}>
  <div class="kit-diff-view__header">
    <KitIcon name="chevron-down" />
    <span class="kit-diff-view__file">{diff.fileName}</span>
    <span class="kit-diff-view__removed">-{diff.removed}</span>
    <span class="kit-diff-view__added">+{diff.added}</span>
  </div>
  <div class="kit-diff-view__lines">
    {
      diff.lines.map((line) => (
        <Fragment>
          {line.kind === "collapsed" ? (
            <div class="kit-diff-view__collapsed">{line.label}</div>
          ) : (
            <div class="kit-diff-view__line" data-diff-kind={line.kind} {...scenePartAttributes(line.scenePart)}>
              <span class="kit-diff-view__number">{line.lineNumber}</span>
              <span class="kit-diff-view__text">{line.text}</span>
            </div>
          )}
          {line.kind !== "collapsed" &&
          line.kind === annotationAfterLine?.kind &&
          line.lineNumber === annotationAfterLine.lineNumber ? (
            <div class="kit-diff-view__annotation">
              <div class="kit-diff-view__annotation-content"><slot name="annotation" /></div>
            </div>
          ) : null}
        </Fragment>
      ))
    }
  </div>
</div>

<style>
  .kit-diff-view {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--kit-canvas);
  }

  .kit-diff-view__header {
    display: flex;
    align-items: center;
    gap: 0.6em;
    height: 2.8em;
    padding-inline: 0.8em;
    border-bottom: 1px solid var(--kit-separator);
    background: var(--kit-tree);
    font-size: 0.95em;
  }

  .kit-diff-view__file {
    flex: 1 1 auto;
    font-weight: 500;
  }

  .kit-diff-view__removed {
    color: var(--kit-removed);
  }

  .kit-diff-view__added {
    color: var(--kit-added);
  }

  .kit-diff-view__lines {
    font-family: var(--kit-font-mono);
    font-size: 0.98em;
    line-height: 1.6;
  }

  .kit-diff-view__collapsed {
    padding: 0.35em 3.6em;
    background: rgb(255 255 255 / 6%);
    color: var(--kit-text-faint);
  }

  .kit-diff-view__line {
    display: flex;
    gap: 1.2em;
    border-left: 0.2em solid transparent;
    white-space: pre;
  }

  .kit-diff-view__line[data-diff-kind="added"] {
    border-left-color: var(--kit-added);
    background: rgb(166 227 161 / 12%);
  }

  .kit-diff-view__line[data-diff-kind="removed"] {
    border-left-color: var(--kit-removed);
    background: rgb(243 139 168 / 12%);
  }

  .kit-diff-view__number {
    flex: none;
    width: 2.4em;
    color: var(--kit-text-faint);
    text-align: right;
  }

  .kit-diff-view__text {
    min-width: 0;
    overflow: hidden;
  }

  .kit-diff-view__annotation {
    display: grid;
    grid-template-rows: 1fr;
    overflow: hidden;
  }

  .kit-diff-view__annotation-content {
    min-height: 0;
    overflow: hidden;
  }
</style>
