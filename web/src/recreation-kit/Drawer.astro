---
import { scenePartAttributes } from "./recreation-kit-dom";

interface Props {
  readonly scenePart?: string | undefined;
}

const { scenePart } = Astro.props;
---

<!-- A task-owned drawer attached beneath its pane, as in task-drawer-tools.png. -->
<div class="kit-drawer" {...scenePartAttributes(scenePart)}>
  <span class="kit-drawer__handle"></span>
  <div class="kit-drawer__body">
    <slot />
  </div>
</div>

<style>
  .kit-drawer {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    margin: 0 0.6em;
    padding: 0.3em 0.45em 0.45em;
    border: 1px solid var(--kit-drawer-edge);
    border-bottom: 0;
    border-radius: 0.8em 0.8em 0 0;
    background: var(--kit-drawer-edge);
    box-shadow: 0 -0.6em 1.4em rgb(0 0 0 / 25%);
  }

  .kit-drawer__handle {
    align-self: center;
    width: 2.6em;
    height: 0.22em;
    margin-bottom: 0.3em;
    border-radius: 0.2em;
    background: rgb(255 255 255 / 22%);
  }

  .kit-drawer__body {
    flex: 1 1 0;
    min-height: 0;
    overflow: clip;
    border-radius: 0.5em;
    background: var(--kit-canvas);
  }
</style>
