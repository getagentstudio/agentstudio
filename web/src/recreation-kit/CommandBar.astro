---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitCommandBarModel, KitSettledPresence } from "./recreation-kit-model";

interface Props {
  readonly commandBar: KitCommandBarModel;
  /** Whether the whole bar is open in the scene's settled frame. */
  readonly settledPresence: KitSettledPresence;
  readonly scenePart?: string | undefined;
  readonly placeholderPart?: string | undefined;
  readonly queryPart?: string | undefined;
  readonly shortcutPart?: string | undefined;
}

const { commandBar, settledPresence, scenePart, placeholderPart, queryPart, shortcutPart } = Astro.props;
const hasQuery = commandBar.query !== "";
---

<!-- Cmd+P command bar floating over the workspace, as in command-bar.png. -->
<div
  class="kit-command-bar"
  data-kit-presence={settledPresence === "collapsed" ? "collapsed" : undefined}
  {...scenePartAttributes(scenePart)}
>
  <div class="kit-command-bar__context">
    <KitIcon name="pane" />
    {commandBar.contextLabel}
  </div>
  <div class="kit-command-bar__search">
    {commandBar.shortcutHint === undefined ? null : <kbd class="kit-command-bar__key kit-command-bar__shortcut" {...scenePartAttributes(shortcutPart)}>{commandBar.shortcutHint}</kbd>}
    <KitIcon name="search" />
    <span class="kit-command-bar__search-text">
      <span
        class="kit-command-bar__placeholder"
        data-kit-presence={hasQuery ? "collapsed" : undefined}
        {...scenePartAttributes(placeholderPart)}>{commandBar.placeholder}</span
      >
      <span class="kit-command-bar__query" data-kit-typed {...scenePartAttributes(queryPart)}
        >{commandBar.query}</span
      >
    </span>
  </div>
  <div class="kit-command-bar__results">
    {
      commandBar.sections.map((section) => (
        <div
          class="kit-command-bar__collapsible"
          data-kit-presence={section.settledPresence === "collapsed" ? "collapsed" : undefined}
          {...scenePartAttributes(section.scenePart)}
        >
          <div class="kit-command-bar__collapsible-inner">
            <p class="kit-command-bar__section">{section.title}</p>
            {section.rows.map((row) => (
              <div
                class="kit-command-bar__collapsible"
                data-kit-presence={row.settledPresence === "collapsed" ? "collapsed" : undefined}
                {...scenePartAttributes(row.scenePart)}
              >
                <div class="kit-command-bar__collapsible-inner">
                  <div class="kit-command-bar__row" data-selected={row.selected ? "" : undefined} data-has-subtitle={row.subtitle === undefined ? undefined : ""}>
                    <KitIcon name={row.icon} />
                    <span class="kit-command-bar__row-copy"><span class="kit-command-bar__label">{row.label}</span>{row.subtitle === undefined ? null : <span class="kit-command-bar__subtitle">{row.subtitle}</span>}</span>
                    {row.meta === undefined ? null : (
                      <span class="kit-command-bar__meta" data-kit-phone="hidden">
                        {row.meta}
                      </span>
                    )}
                    <KitIcon name="chevron-right" class="kit-command-bar__chevron" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <div class="kit-command-bar__footer">
    <div class="kit-command-bar__hints">
      <span>{commandBar.scopeHints.join("  ·  ")}</span>
      <span data-kit-phone="hidden">{commandBar.closeHint}</span>
    </div>
    <div class="kit-command-bar__hints kit-command-bar__hints--actions" data-kit-phone="hidden">
      {
        commandBar.actionHints.map((hint) => (
          <span class="kit-command-bar__action">
            <span class="kit-command-bar__key">
              <KitIcon name={hint.icon} />
            </span>
            {hint.label}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .kit-command-bar {
    position: absolute;
    /* Centered by margins, not translate, so scene tweens own the transform. */
    top: 16%;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    width: min(46em, 86%);
    max-height: 78%;
    overflow: hidden;
    border: 1px solid var(--kit-floating-border);
    border-radius: 1em;
    background: var(--kit-floating);
    margin-inline: auto;
    box-shadow: 0 1.8em 4em rgb(0 0 0 / 55%);
  }

  .kit-command-bar__context {
    display: flex;
    align-items: center;
    align-self: flex-end;
    gap: 0.4em;
    padding: 0.7em 1em 0;
    color: var(--kit-text-supporting);
    font-size: 0.92em;
    font-weight: 500;
  }

  .kit-command-bar__search {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.55em 1em 0.8em;
    border-bottom: 1px solid var(--kit-separator);
    color: var(--kit-text-faint);
    font-size: 1.15em;
  }

  .kit-command-bar__search-text {
    display: grid;
    flex: 1 1 0;
    min-width: 0;
  }

  .kit-command-bar__placeholder,
  .kit-command-bar__query {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: pre;
  }

  .kit-command-bar__query {
    color: var(--kit-text);
  }

  .kit-command-bar__results {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    padding: 0.3em 0.45em;
    overflow: hidden;
  }

  .kit-command-bar__collapsible {
    display: grid;
    grid-template-rows: 1fr;
  }

  .kit-command-bar__collapsible[data-kit-presence="collapsed"] {
    grid-template-rows: 0fr;
  }

  .kit-command-bar__collapsible-inner {
    min-height: 0;
    overflow: hidden;
  }

  .kit-command-bar__section {
    margin: 0.6em 0.55em 0.3em;
    color: var(--kit-primary);
    font-size: 0.86em;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .kit-command-bar__row {
    display: flex;
    align-items: center;
    gap: 0.7em;
    height: 2.6em;
    padding-inline: 0.6em;
    border-radius: 0.5em;
    color: var(--kit-text);
    white-space: nowrap;
  }

  .kit-command-bar__row[data-selected] {
    background: var(--kit-command-selected);
  }

  .kit-command-bar__label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
  }
  .kit-command-bar__row-copy { display: flex; flex: 1 1 auto; flex-direction: column; min-width: 0; }
  .kit-command-bar__row[data-has-subtitle] { height: 3.6em; }
  .kit-command-bar__subtitle { overflow: hidden; color: var(--kit-text-supporting); font-size: 0.85em; text-overflow: ellipsis; }

  .kit-command-bar__meta {
    flex: none;
    color: var(--kit-text-supporting);
    font-size: 0.92em;
  }

  .kit-command-bar__row :global(.kit-command-bar__chevron) {
    color: var(--kit-text-faint);
  }

  .kit-command-bar__footer {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.35em;
    padding: 0.55em 1em 0.7em;
    border-top: 1px solid var(--kit-separator);
    color: var(--kit-text-faint);
    font-size: 0.86em;
  }

  .kit-command-bar__hints {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    white-space: pre;
  }

  .kit-command-bar__hints--actions {
    justify-content: flex-start;
  }

  .kit-command-bar__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--kit-text-supporting);
  }

  .kit-command-bar__key {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 0.3em;
    background: rgb(255 255 255 / 8%);
  }
  .kit-command-bar__shortcut { width: auto; min-width: 2em; padding: 0.1em 0.35em; border: 1px solid var(--kit-outline); font: inherit; font-size: 0.82em; color: var(--kit-text-supporting); }

  @container recreation-kit (max-width: 600px) {
    .kit-command-bar {
      top: 8%;
      width: 92%;
      max-height: 86%;
    }
  }
</style>
