---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitSourceViewModel } from "./recreation-kit-model";

interface Props {
  readonly source: KitSourceViewModel;
  readonly scenePart?: string | undefined;
  readonly linePartPrefix?: string | undefined;
}

const { source, scenePart, linePartPrefix } = Astro.props;
---

<!-- A source file with its path header, as in files.png. -->
<div class="kit-source-view" {...scenePartAttributes(scenePart)}>
  <div class="kit-source-view__header">
    <KitIcon name="file" />
    <span class="kit-source-view__path">{source.filePath}</span>
    <KitIcon name="gear" class="kit-source-view__gear" />
  </div>
  <div class="kit-source-view__code">
    {
      source.lines.map((line, lineIndex) => (
        <div
          class="kit-source-view__line"
          {...scenePartAttributes(
            linePartPrefix === undefined ? undefined : `${linePartPrefix}-${lineIndex}`,
          )}
        >
          <span class="kit-source-view__number">{line.lineNumber}</span>
          <span class="kit-source-view__text">
            {line.tokens.map((token) => (
              <span data-code-tone={token.tone}>{token.text}</span>
            ))}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .kit-source-view {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--kit-canvas);
  }

  .kit-source-view__header {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5em;
    height: 2.8em;
    padding-inline: 0.8em;
    border-bottom: 1px solid var(--kit-separator);
    background: var(--kit-tree);
    color: var(--kit-text-supporting);
    font-size: 0.95em;
    white-space: nowrap;
  }

  .kit-source-view__path {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kit-source-view__code {
    overflow: clip;
    padding: 0.6em 0;
    font-family: var(--kit-font-mono);
    font-size: 0.98em;
    line-height: 1.6;
  }

  .kit-source-view__line {
    display: flex;
    gap: 1.2em;
    white-space: pre;
  }

  .kit-source-view__number {
    flex: none;
    width: 2.4em;
    color: var(--kit-text-faint);
    text-align: right;
  }

  .kit-source-view__text {
    min-width: 0;
    overflow: hidden;
  }

  [data-code-tone="keyword"] {
    color: var(--kit-syntax-keyword);
  }

  [data-code-tone="type"] {
    color: var(--kit-syntax-type);
  }

  [data-code-tone="function"] {
    color: var(--kit-syntax-function);
  }

  [data-code-tone="string"] {
    color: var(--kit-syntax-string);
  }

  [data-code-tone="comment"] {
    color: var(--kit-syntax-comment);
  }

  [data-code-tone="punctuation"] {
    color: var(--kit-text-supporting);
  }
</style>
