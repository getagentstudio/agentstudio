---
// The page's git-graph topology: a mainline on the left with one dot per row,
// worktree lanes in the gutter, and a one-column branch into each chapter
// target. full-page-topology-layout.ts fills the route and node layers from
// the chapter DOM contract; topology-scroll-reveal.ts reveals it on scroll.
---

<svg
  class="block h-full w-full opacity-80"
  data-full-page-topology
  viewBox="0 0 1000 5200"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="topology-vertical-reveal-gradient" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="white" stop-opacity="1" />
      <stop offset="1" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <mask id="topology-vertical-reveal-mask" maskUnits="userSpaceOnUse">
      <rect data-topology-reveal-solid x="0" y="0" width="1000" height="0" fill="white" />
      <rect
        data-topology-reveal-fade
        x="0"
        y="0"
        width="1000"
        height="0"
        fill="url(#topology-vertical-reveal-gradient)"
      />
    </mask>
    <linearGradient id="topology-rail-vibrancy-gradient" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="white" />
      <stop offset="1" stop-color="black" />
    </linearGradient>
    <mask id="topology-rail-vibrancy-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse">
      <rect data-topology-vibrancy-mask-rect x="0" y="0" width="1000" height="5200" fill="url(#topology-rail-vibrancy-gradient)" />
    </mask>
    <linearGradient id="topology-rail-opacity-gradient" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="white" />
      <stop offset="1" stop-color="black" />
    </linearGradient>
    <mask id="topology-rail-opacity-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse">
      <rect data-topology-opacity-mask-rect x="0" y="0" width="1000" height="5200" fill="url(#topology-rail-opacity-gradient)" />
    </mask>
    <filter id="topology-rail-grey" x="0" y="0" width="100%" height="100%">
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncR type="linear" slope="0.7" />
        <feFuncG type="linear" slope="0.7" />
        <feFuncB type="linear" slope="0.7" />
      </feComponentTransfer>
    </filter>
    <g id="topology-rail-source">
      <g class="topology-primary">
        <path
          class="topology-mainline topology-line topology-reveal-path"
          data-mainline
          data-topology-path-role="core"
          data-topology-path-start="0"
          data-topology-path-end="1"
        />
      </g>
      <g data-topology-routes></g>
      <g data-topology-row-nodes></g>
    </g>
  </defs>
  <g data-topology-reveal-layer mask="url(#topology-vertical-reveal-mask)">
    <g data-topology-opacity-layer mask="url(#topology-rail-opacity-mask)">
      <use data-topology-grey-copy href="#topology-rail-source" filter="url(#topology-rail-grey)" />
      <g data-topology-colour-layer mask="url(#topology-rail-vibrancy-mask)">
        <use data-topology-colour-copy href="#topology-rail-source" />
      </g>
    </g>
  </g>
</svg>

<script>
  import { layoutFullPageTopology } from "./full-page-topology-layout";
  import { initializeTopologyScrollReveal } from "./topology-scroll-reveal";

  const artwork = document.querySelector<SVGSVGElement>("[data-full-page-topology]");
  if (artwork !== null) {
    initializeTopologyScrollReveal(artwork, layoutFullPageTopology);
  }
</script>

<style>
  :global([data-full-page-topology] path),
  :global([data-full-page-topology] circle) {
    vector-effect: non-scaling-stroke;
  }

  .topology-mainline,
  :global(.topology-route > path) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .topology-mainline {
    stroke: color-mix(in srgb, var(--color-primary) 46%, transparent);
    stroke-width: var(--rail-trunk-width);
  }

  :global(.topology-route > path) {
    stroke-width: var(--rail-line-width);
  }

  :global(.topology-route > .topology-clearance) {
    stroke: var(--color-canvas);
    stroke-width: 5px;
  }

  .topology-reveal-path,
  :global(.topology-reveal-path) {
    stroke-dasharray: none;
    stroke-dashoffset: 0;
  }

  [data-topology-current-node]:not(.node-terminal-group),
  :global([data-topology-current-node]:not(.node-terminal-group)) {
    animation: topology-current-node-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.accent-peach) {
    color: var(--color-parallel);
  }

  :global(.accent-cyan) {
    color: var(--color-glyph);
  }

  :global(.accent-main) {
    color: var(--color-primary);
  }

  :global(.accent-peach > path) {
    stroke: color-mix(in srgb, var(--color-parallel) 34%, transparent);
  }

  :global(.accent-cyan > path) {
    stroke: color-mix(in srgb, var(--color-glyph) 36%, transparent);
  }

  :global(.accent-main.topology-route > path:not(.topology-clearance)) {
    stroke: color-mix(in srgb, var(--color-primary) 46%, transparent);
  }

  :global([data-route-kind="attach"].accent-main > path:not(.topology-clearance)) {
    stroke: var(--color-primary);
  }

  /* Attach branches enter a target edge, shifting hue from their source lane
     to primary blue along the same weight as the other lines. */
  :global(.accent-port) {
    color: var(--color-primary);
  }

  :global(.accent-port > path:not(.topology-clearance)) {
    stroke: color-mix(in srgb, var(--color-primary) 46%, transparent);
  }

  :global([data-topology-terminal-route] > path:not(.topology-clearance)) {
    stroke: var(--color-primary);
  }

  :global(.topology-port-stop-main),
  :global(.topology-port-stop-port) {
    stop-color: color-mix(in srgb, var(--color-primary) 46%, transparent);
  }

  :global(.topology-port-stop-peach) {
    stop-color: color-mix(in srgb, var(--color-parallel) 34%, transparent);
  }

  :global(.topology-port-stop-cyan) {
    stop-color: color-mix(in srgb, var(--color-glyph) 36%, transparent);
  }

  /* Node vocabulary, by data-node-kind:
     - commit and fork: a small solid dot in its lane's color (the branch line
       shows the fork);
     - merge: a medium ring in the incoming lane's color around a small dot in
       the receiving lane's color, a two-parent commit;
     - chapter: a medium primary ring, hollow while upcoming, solid once passed;
       the current chapter is the terminal node below;
     - end: the terminal node.
     Until the reveal reaches it, every glyph is a faint thin outline at its
     own size, so the size hierarchy shows before identity and color do. */
  :global([data-topology-suppressed]) { display: none; }
  :global([data-node] .node-commit),
  :global([data-node] .node-chapter),
  :global([data-node] .node-merge-ring),
  :global([data-node] .node-end-ring) {
    fill: var(--color-canvas);
    stroke: color-mix(in srgb, var(--color-ink-faint) 45%, transparent);
    stroke-width: 1px;
    transition:
      fill 240ms ease,
      stroke 240ms ease,
      stroke-width 240ms ease;
  }

  :global([data-node] .node-merge-core),
  :global([data-node] .node-end-core) {
    fill: currentColor;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  :global([data-node][data-topology-node-revealed] .node-commit) {
    fill: currentColor;
    stroke: currentColor;
  }

  :global([data-node][data-topology-node-revealed] .node-merge-ring),
  :global([data-node][data-topology-node-revealed] .node-end-ring) {
    stroke: currentColor;
    stroke-width: 2px;
  }

  :global([data-node][data-topology-node-revealed] .node-merge-core),
  :global([data-node][data-topology-node-revealed] .node-end-core) {
    opacity: 1;
  }

  :global([data-node][data-topology-node-revealed] .node-chapter) {
    stroke: var(--color-primary);
    stroke-width: 2px;
  }

  :global([data-node][data-topology-node-revealed][data-chapter-state="passed"] .node-chapter) {
    fill: var(--color-primary);
  }

  /* Terminal nodes: the current chapter and the page's last row. The current
     chapter's halo pulses once as it becomes current, then holds as a ring. */
  :global(.node-terminal),
  :global(.node-terminal-halo) {
    display: none;
  }

  :global([data-chapter-state="current"] .node-chapter),
  :global([data-node-kind="end"][data-topology-node-revealed] .node-commit) {
    display: none;
  }

  :global([data-chapter-state="current"] .node-terminal),
  :global([data-node-kind="end"][data-topology-node-revealed] .node-terminal) {
    display: inline;
    fill: var(--color-primary);
    stroke: var(--color-primary);
  }

  :global([data-chapter-state="current"] .node-terminal-halo),
  :global([data-topology-terminal][data-topology-node-revealed] .node-terminal-halo) {
    display: inline;
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2px;
    opacity: 0.72;
    transform: scale(1.6);
    transform-box: fill-box;
    transform-origin: center;
    animation: topology-terminal-node-halo-once 1.8s ease-out 1 both;
  }
  :global([data-topology-terminal-node][data-topology-terminal] .node-terminal-halo) { display: none; }

  /* The retired terminal halo (scale 1 → 2.35 while fading), played once, then
     the ring grows back in and holds at its resting size. */
  @keyframes topology-terminal-node-halo-once {
    0% {
      opacity: 0.72;
      transform: scale(1);
    }

    55% {
      opacity: 0;
      transform: scale(2.35);
    }

    56% {
      opacity: 0;
      transform: scale(1);
    }

    100% {
      opacity: 0.72;
      transform: scale(1.6);
    }
  }

  @keyframes topology-current-node-pulse {
    0%,
    100% {
      stroke-width: 1px;
      transform: scale(1);
    }

    45%,
    62% {
      stroke-width: 1px;
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-topology-current-node]) {
      animation: none;
    }

    :global([data-node] .node-commit),
    :global([data-node] .node-chapter),
    :global([data-node] .node-merge-ring),
    :global([data-node] .node-merge-core),
    :global([data-node] .node-end-ring),
    :global([data-node] .node-end-core) {
      transition: none;
    }

    :global([data-chapter-state="current"] .node-terminal-halo),
    :global([data-topology-terminal][data-topology-node-revealed] .node-terminal-halo) {
      animation: none;
    }
  }
</style>
