{
  "name": "@agentstudio/marketing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:captures": "node --experimental-strip-types scripts/audit-capture-pixels.ts",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node --experimental-strip-types scripts/verify-session-restore-player.ts && node --experimental-strip-types scripts/stage-cloudflare-build-config.ts",
    "build:media-callout": "node --experimental-strip-types scripts/build-media-callout.ts",
    "build:scene-bundles": "ASTRO_TELEMETRY_DISABLED=1 node --experimental-strip-types scripts/build-scene-bundles.ts",
    "campaign:links": "node --experimental-strip-types scripts/list-campaign-links.ts",
    "campaign:requests": "node --experimental-strip-types scripts/query-campaign-request-analytics.ts",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run verify:captures && pnpm run audit:captures && pnpm run test:unit && pnpm run test:browser",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "generate:marketing-assets": "pnpm run generate:social-card && pnpm run generate:youtube-banner && pnpm run generate:x-profile-banner",
    "generate:social-card": "node --experimental-strip-types scripts/generate-social-card.ts",
    "generate:x-profile-banner": "node --experimental-strip-types scripts/generate-x-profile-banner.ts",
    "generate:youtube-banner": "node --experimental-strip-types scripts/generate-youtube-banner.ts",
    "lint": "oxlint --type-aware src scripts tests",
    "normalize:captures": "node --experimental-strip-types scripts/stamp-srgb-color-profile.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test:browser": "vitest run --project browser",
    "test:unit": "vitest run --project unit",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "verify:cloudflare-discovery": "node --experimental-strip-types scripts/verify-cloudflare-discovery-assets.ts",
    "verify:captures": "node --experimental-strip-types scripts/verify-capture-assets.ts"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vite-plugin": "^1.53.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "astro": "7.2.2",
    "cf": "0.6.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@11.14.0"
}
